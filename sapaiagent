def count_idocs_by_status(status):
    status = clean_value(status)

    if not status:
        return {"status": "error", "message": "IDoc status is missing"}

    data = call_sap(IDOC_URL, {
        "$filter": f"Status eq '{status}'",
        "$inlinecount": "allpages",
        "$top": "1"
    })

    if data.get("status") == "error":
        return data

    return {
        "status": "success",
        "type": "idoc_status_count",
        "data": {
            "Status": status,
            "TotalIDocs": extract_count(data)
        }
    }


def check_failed_idoc(idoc_number):
    idoc_number = clean_value(idoc_number).zfill(16)

    data = call_sap(IDOC_URL, {
        "$filter": f"Docnum eq '{idoc_number}'"
    })

    if data.get("status") == "error":
        return data

    results = data.get("d", {}).get("results", [])

    if not results:
        return {"status": "not_found", "message": f"IDoc {idoc_number} not found"}

    item = results[0]

    return {
        "status": "success",
        "type": "idoc",
        "data": {
            "IDoc": item.get("Docnum"),
            "Status": item.get("Status"),
            "MessageType": item.get("MessageType"),
            "CreatedDate": item.get("CreatedDate"),
            "ErrorText": item.get("ErrorText")
        }
    }


