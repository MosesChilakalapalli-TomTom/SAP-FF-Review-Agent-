def ai_router(question):
    prompt = """
You are a secure SAP assistant router.
Return ONLY valid JSON. No markdown. No explanation.

Actions:
- check_failed_idoc
- count_idocs_by_status
- check_cost_center
- count_cost_centers
- check_sales_order
- count_sales_orders
- check_purchase_order
- count_purchase_orders
- check_business_partner
- check_outbound_delivery
- unknown

JSON format:
{
  "action": "",
  "value": "",
  "controlling_area": "TT01"
}

Rules:
- If user asks how many IDocs are in status 51, 56, 68, etc., use count_idocs_by_status and put status in value.
- If user asks for one specific IDoc number, use check_failed_idoc.
- If user asks how many cost centers or total cost centers, use count_cost_centers.
- If user asks for one specific cost center, use check_cost_center.
- If user asks how many sales orders or total sales orders, use count_sales_orders.
- If user asks for one specific sales order, use check_sales_order.
- If user asks how many purchase orders or total purchase orders or POs, use count_purchase_orders.
- If user asks for one specific purchase order or PO, use check_purchase_order.
- If user asks for one specific business partner or BP, use check_business_partner.
- If user asks about outbound delivery, delivery, delivery status, or tracking delivery, use check_outbound_delivery.
- If controlling area is missing, use TT01.
- For count actions except IDoc status count, value can be empty.
- Never ask for passwords, tokens, cookies, or credentials.
"""

    response = azure_client.chat.completions.create(
        model=AZURE_OPENAI_DEPLOYMENT,
        messages=[
            {"role": "system", "content": prompt},
            {"role": "user", "content": question.strip()}
        ],
        temperature=0,
        max_tokens=150
    )

    try:
        return json.loads(response.choices[0].message.content.strip())
    except Exception:
        return {"action": "unknown", "value": "", "controlling_area": "TT01"}


def ai_format_answer(question, sap_result):
    response = azure_client.chat.completions.create(
        model=AZURE_OPENAI_DEPLOYMENT,
        messages=[
            {
                "role": "system",
                "content": (
                    "You are an SAP assistant. Answer in simple English. "
                    "Use only the SAP result provided. "
                    "Do not expose credentials, URLs, tokens, or secrets. "
                    "If count is available, clearly state the count."
                )
            },
            {
                "role": "user",
                "content": f"Question: {question}\n\nSAP result:\n{json.dumps(sap_result, indent=2)}"
            }
        ],
        temperature=0,
        max_tokens=400
    )

    return response.choices[0].message.content.strip()


def run_agent(question):
    question = question.strip()
    route = ai_router(question)

    action = clean_value(route.get("action", "unknown"))
    value = clean_value(route.get("value", ""))
    controlling_area = clean_value(route.get("controlling_area", "TT01")).upper()

    if action == "check_failed_idoc":
        result = check_failed_idoc(value)
    elif action == "count_idocs_by_status":
        result = count_idocs_by_status(value)
    elif action == "check_cost_center":
        result = check_cost_center(value, controlling_area)
    elif action == "count_cost_centers":
        result = count_cost_centers(controlling_area)
    elif action == "check_sales_order":
        result = check_sales_order(value)
    elif action == "count_sales_orders":
        result = count_sales_orders()
    elif action == "check_purchase_order":
        result = check_purchase_order(value)
    elif action == "count_purchase_orders":
        result = count_purchase_orders()
    elif action == "check_business_partner":
        result = check_business_partner(value)
    elif action == "check_outbound_delivery":
        result = check_outbound_delivery(value)
    else:
        return "I can check IDoc, Cost Center, Sales Order, Purchase Order, or Business Partner."

    return ai_format_answer(question, result)


if __name__ == "__main__":
    print("SAP AI Assistant started")
    print("Type exit to stop\n")

    while True:
        question = input("You: ").strip()

        if question.lower() in ["exit", "quit", "bye"]:
            print("Assistant: Bye")
            break

        print("\nAssistant:")
        print(run_agent(question))
        print()