azure_client = AzureOpenAI(
    azure_endpoint=AZURE_OPENAI_ENDPOINT,
    api_key=AZURE_OPENAI_API_KEY,
    api_version=AZURE_OPENAI_API_VERSION
)

session = requests.Session()
session.auth = HTTPBasicAuth(SAP_USER, SAP_PASS)
session.verify = False
session.headers.update({"Accept": "application/json"})

IDOC_URL = f"{SAP_HOST}/sap/opu/odata/sap/ZIDOC_MONITOR_SRV/FailedIdocSet"
COST_CENTER_URL = f"{SAP_HOST}/sap/opu/odata/sap/API_COSTCENTER_SRV/A_CostCenterText"
SO_URL = f"{SAP_HOST}/sap/opu/odata/sap/API_SALES_ORDER_SRV/A_SalesOrder"
PO_URL = f"{SAP_HOST}/sap/opu/odata/sap/API_PURCHASEORDER_PROCESS_SRV/A_PurchaseOrder"
BP_URL = f"{SAP_HOST}/sap/opu/odata/sap/API_BUSINESS_PARTNER/A_BusinessPartner"
OUTBOUND_DELIVERY_URL = f"{SAP_HOST}/sap/opu/odata/sap/API_OUTBOUND_DELIVERY_SRV/A_OutbDeliveryHeader"


def clean_value(value):
    if value is None:
        return ""
    value = str(value).strip()
    value = re.sub(r"\s+", "", value)
    value = re.sub(r"[^A-Za-z0-9._-]", "", value)
    return value


def call_sap(url, params=None):
    query = {
        "sap-client": SAP_CLIENT,
        "saml2": "disabled",
        "$format": "json"
    }

    if params:
        query.update(params)

    try:
        response = session.get(url, params=query, timeout=30)

        if response.status_code != 200:
            return {
                "status": "error",
                "status_code": response.status_code,
                "response": response.text[:1000],
                "url": response.url
            }

        return response.json()

    except Exception as e:
        return {"status": "error", "message": str(e)}


def extract_count(data):
    count = data.get("d", {}).get("__count")
    if count is not None:
        return int(count)

    results = data.get("d", {}).get("results", [])
    return len(results)


def count_cost_centers(controlling_area="TT01"):
    controlling_area = clean_value(controlling_area).upper()

    data = call_sap(COST_CENTER_URL, {
        "$filter": f"ControllingArea eq '{controlling_area}'",
        "$inlinecount": "allpages",
        "$top": "1"
    })

    if data.get("status") == "error":
        return data

    return {
        "status": "success",
        "type": "cost_center_count",
        "data": {
            "ControllingArea": controlling_area,
            "TotalCostCenters": extract_count(data)
        }
    }


